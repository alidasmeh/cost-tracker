rules_version = '2';
// The app talks to Firestore directly; these rules are the "backend".
service cloud.firestore {
  match /databases/{database}/documents {

    // Who may use the app at all. Add more emails to share with someone (they get their own separate data).
    function allowed() {
      return request.auth != null
        && request.auth.token.email in ['alidasmeh@gmail.com'];
    }
    function owner(uid) { return allowed() && request.auth.uid == uid; }

    function validExpense(d) {
      return d.keys().hasOnly(['year', 'month', 'day', 'title', 'amount', 'category', 'note', 'createdAt'])
        && d.year is int && d.year > 1900 && d.year < 3000
        && d.month is int && d.month >= 1 && d.month <= 12
        && (d.day == null || (d.day is int && d.day >= 1 && d.day <= 31))
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.amount is number
        && d.category is string && d.category.size() > 0 && d.category.size() <= 50
        && d.note is string && d.note.size() <= 1000;
    }
    function validMonth(d) {
      return d.keys().hasOnly(['fixed', 'income', 'prediction', 'dailyBudget', 'note'])
        && d.fixed is number && d.income is number && d.prediction is number && d.dailyBudget is number
        && d.note is string && d.note.size() <= 1000;
    }

    // users/{uid}: { categories: [], years: [] }
    match /users/{uid} {
      allow read: if owner(uid);
      allow write: if owner(uid) && request.resource.data.keys().hasOnly(['categories', 'years']);

      match /expenses/{id} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid) && validExpense(request.resource.data);
      }
      match /months/{key} {
        allow read: if owner(uid);
        allow write: if owner(uid) && key.matches('^[0-9]{4}-[0-9]{2}$') && validMonth(request.resource.data);
      }
    }
  }
}
