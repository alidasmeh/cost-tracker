rules_version = '2';
// The app talks to Firestore directly; these rules are the "backend".
service cloud.firestore {
  match /databases/{database}/documents {

    // Anyone signed in may use the app; what they can see is limited to their own wallets below.
    function allowed() { return request.auth != null; }
    function owner(uid) { return allowed() && request.auth.uid == uid; }

    function validExpense(d) {
      return d.keys().hasOnly(['year', 'month', 'day', 'title', 'amount', 'category', 'note', 'createdAt'])
        && d.year is int && d.year > 1900 && d.year < 3000
        && d.month is int && d.month >= 1 && d.month <= 12
        && (d.day == null || (d.day is int && d.day >= 1 && d.day <= 31))
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.amount is number
        && d.category is string && d.category.size() > 0 && d.category.size() <= 50
        && d.note is string && d.note.size() <= 1000;
    }
    function validMonth(d) {
      return d.keys().hasOnly(['fixed', 'income', 'prediction', 'dailyBudget', 'note'])
        && d.fixed is number && d.income is number && d.prediction is number && d.dailyBudget is number
        && d.note is string && d.note.size() <= 1000;
    }

    // users/{uid}: { homeWallet, homeMigrated, defaultWallet }. categories/years/expenses/months are pre-wallet data,
    // kept read-only so the app can copy them into the Home wallet.
    match /users/{uid} {
      allow read: if owner(uid);
      allow write: if owner(uid)
        && request.resource.data.keys().hasOnly(['categories', 'years', 'homeWallet', 'homeMigrated', 'defaultWallet']);
      match /expenses/{id} { allow read: if owner(uid); }
      match /months/{key} { allow read: if owner(uid); }
    }

    // wallets/{code}: { name, owner, members: [uid], categories: [], years: [], createdAt }
    // The code is the doc ID. Knowing it is what lets someone join, so it is never listed to non-members.
    function member(code) {
      return allowed() && request.auth.uid in get(/databases/$(database)/documents/wallets/$(code)).data.members;
    }
    function changes() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function me() { return request.auth.uid; }

    match /wallets/{code} {
      allow read: if allowed() && me() in resource.data.members;
      // Creating only works if the code is free: writing over an existing wallet counts as an update.
      allow create: if allowed() && code.matches('^[A-Z0-9]{6}$')
        && request.resource.data.keys().hasOnly(['name', 'owner', 'members', 'categories', 'years', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.owner == me() && request.resource.data.members == [me()]
        && request.resource.data.categories is list && request.resource.data.years is list
        && request.resource.data.createdAt is int;
      allow update: if allowed() && (
        // members: rename, remember categories/years
        (me() in resource.data.members && changes().hasOnly(['name', 'categories', 'years'])
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40)
        // join with the code: add only yourself
        || (!(me() in resource.data.members) && changes().hasOnly(['members'])
          && request.resource.data.members == resource.data.members.concat([me()]))
        // leave: remove only yourself
        || (me() in resource.data.members && changes().hasOnly(['members'])
          && request.resource.data.members == resource.data.members.removeAll([me()]))
      );

      match /expenses/{id} {
        allow read, delete: if member(code);
        allow create, update: if member(code) && validExpense(request.resource.data);
      }
      match /months/{key} {
        allow read: if member(code);
        allow write: if member(code) && key.matches('^[0-9]{4}-[0-9]{2}$') && validMonth(request.resource.data);
      }
    }
  }
}
